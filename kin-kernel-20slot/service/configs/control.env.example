KIN_CONTROL_ADDR=0.0.0.0:9090
KIN_HEARTBEAT_TIMEOUT_SECONDS=20
KIN_RECONCILE_INTERVAL_SECONDS=5
KIN_SNAPSHOT_TTL_SECONDS=3600

# Must resolve to the same SQLite file used by the Node control panel.
KIN_DATA_DIR=./data
KIN_DB_PATH=./data/kin.db

# Required for every /api/v1/* request. Generate a high-entropy value and
# expose it only to the trusted Node BFF and kin-control.
KIN_CONTROL_INTERNAL_TOKEN=replace-with-random-internal-token

# Required for secret writes/reveal/refresh. Without it, health and non-secret
# reads remain available but secret operations fail closed.
KIN_DB_SECRET=replace-with-random-database-secret

