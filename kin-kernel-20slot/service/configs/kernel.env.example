KIN_KERNEL_ADDR=0.0.0.0:8080
# One kernel runtime == one Claude OS process. Slots are MCP-blocked subagents (POC: 5).
KIN_ISOLATION=subagent-pool
KIN_WORKER_COUNT=1
KIN_SLOTS_PER_WORKER=5
KIN_MAX_BODY_BYTES=2097152
KIN_MAX_SESSION_BYTES=16777216
KIN_SESSION_TTL_SECONDS=3600
KIN_CONTINUATION_TTL_SECONDS=600
KIN_DEFAULT_TENANT=demo
KIN_EXPOSE_SLOT_HEADER=true
# mock | anthropic_api | local_cli
KIN_PROVIDER=mock
# Execution mode. Defaults to native_messages (stateless v2, prd.md AC19).
# mcp_slot is the supported rollback path.
# KIN_EXECUTION_MODE=mcp_slot
# native_slot/native_agent is frozen and NOT exposed by default: it runs host
# tools with permissions unconditionally allowed (P0-5). Selecting it also
# requires the explicit acknowledgement below (prd.md AC18).
# KIN_ALLOW_NATIVE_AGENT=i-understand-host-tools-are-exposed
# local_cli:
# KIN_CLAUDE_BIN=/usr/local/bin/claude
# KIN_HTTPS_PROXY=http://127.0.0.1:18080
# KIN_SOCKS5=socks5h://user:pass@host:port
# KIN_CLAUDE_AI_OAUTH_JSON={"accessToken":"...","refreshToken":"...","expiresAt":0,"scopes":["user:profile","user:inference","user:sessions:claude_code","user:mcp_servers","user:file_upload"]}
# setup-token (claude setup-token, inference-only, no refresh). Either:
# KIN_CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...AA
# or KIN_CLAUDE_AI_OAUTH_JSON with kind=setup-token / empty refreshToken / sub2api export.
# Optional: three-way config_hash integrity check (design.md §6, prd.md R7).
# Set to the RuntimeProfile config_hash the Go control plane computed and
# expects the native CLI to echo back in kin_host_ready. Read once at process
# startup only; config changes require drain + restart, never a live re-fetch.
# Omit to skip validation entirely.
# KIN_DESIRED_CONFIG_HASH=<sha256 hex from GET /api/v1/runtime-profile>
RUST_LOG=kin_kernel=info,tower_http=info
