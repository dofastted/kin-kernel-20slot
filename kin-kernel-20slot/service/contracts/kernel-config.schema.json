{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kin.example/schemas/kernel-config.schema.json",
  "title": "Kin kernel route policy snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "revision", "routes"],
  "properties": {
    "apiVersion": {"const": "kin.openai.local/v1alpha1"},
    "kind": {"const": "RoutePolicySet"},
    "revision": {"type": "integer", "minimum": 1},
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "match", "target", "isolation", "admission", "timeouts", "retries"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenant", "model_patterns"],
          "properties": {
            "tenant": {"type": "string", "minLength": 1, "maxLength": 128},
            "model_patterns": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "slot_group"],
          "properties": {
            "provider": {"type": "string", "enum": ["mock", "anthropic_api", "openai_api", "local_cli"]},
            "slot_group": {"type": "string", "minLength": 1, "maxLength": 128}
          }
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "domain"],
          "properties": {
            "mode": {"type": "string", "enum": ["process_per_turn", "process_per_session", "reset_and_reuse", "multiplexed"]},
            "domain": {"type": "string", "enum": ["tenant", "trust_group", "dedicated"]}
          }
        },
        "admission": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_inflight", "max_waiting_tool", "queue_limit", "queue_timeout_ms"],
          "properties": {
            "max_inflight": {"type": "integer", "minimum": 1, "maximum": 100000},
            "max_waiting_tool": {"type": "integer", "minimum": 0, "maximum": 100000},
            "queue_limit": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "queue_timeout_ms": {"type": "integer", "minimum": 0, "maximum": 60000}
          }
        },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_byte_ms", "total_ms", "continuation_ttl_ms"],
          "properties": {
            "first_byte_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
            "total_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000},
            "continuation_ttl_ms": {"type": "integer", "minimum": 1000, "maximum": 86400000}
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_first_byte", "after_first_byte"],
          "properties": {
            "before_first_byte": {"type": "integer", "minimum": 0, "maximum": 3},
            "after_first_byte": {"const": 0}
          }
        }
      }
    }
  }
}

