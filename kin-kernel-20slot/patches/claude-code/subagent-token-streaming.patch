+/**
+ * What runAgent yields.
+ *
+ * Beyond finalized Messages, runAgent forwards raw `stream_event` deltas so
+ * callers can render a sub-agent's output token-by-token — the same SSE the
+ * main loop consumes. Deltas are transient: never recorded to the sidechain
+ * transcript, never added to the agent's own message list.
+ *
+ * Lives here rather than in runAgent.ts so consumers (agentToolUtils,
+ * inProcessRunner, ...) can import the guard without a cyclic import.
+ */
+export type AgentRuntimeMessage = Message | StreamEvent
+
+/**
+ * Narrows an AgentRuntimeMessage to a transient stream delta.
+ *
+ * A bare `msg.type === 'stream_event'` check does NOT narrow this union:
+ * StreamEvent['type'] is a wide `string`, so TypeScript keeps StreamEvent in
+ * the else branch and pushing it into a `Message[]` fails to compile. Callers
+ * that collect finalized messages must use this predicate.
+ */
+export function isAgentStreamEvent(
+  msg: AgentRuntimeMessage,
+): msg is StreamEvent {
+  return msg.type === 'stream_event'
+}
