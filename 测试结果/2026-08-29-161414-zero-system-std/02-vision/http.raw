event: content_block_delta
data: {"delta":{"text":"这是一张 **Google 涂鸦(Doodle)** 图片，标题为 **\"World C","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"up 2026: The Art of the Bicycle Kick\"**（2026年世界杯：倒钩射门的艺术）。\n\n**背景介绍：**\n- 这","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"是 Google 在 2026 年 6 月 17 日左右推出的一系列庆祝 **2026 年 FIFA 世界杯** 的涂鸦之","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"一。\n- 这个系列以足球的各种精彩技巧为主题，这一张专门致敬 **\"","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"倒钩射门\"（Bicycle Kick，也称\"剪刀脚\"或\"倒挂金钩\"）**——一种球","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"员跃起后用剪刀式的腿部动作将球向身后踢出的高","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"难度动作，需要极高的运动能力、精准的时机把握和大胆的技巧。\n- 该系列还包括其他足","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"球技巧主题的涂鸦，例如：\"凌空抽射的艺术\"（Volley）、\"","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"彩虹过人\"（Rabona）、\"踩单车\"（Elástico）、\"点球的艺术\"（Penal","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"ty Kick）、\"头球俯冲\"（Diving Header）、\"长传球艺术\"（Long Ball）、\"香蕉球艺术\"（Curler）、\"滑铲","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"\"（Sliding Tackle）等等。\n\n简单来说，这就是 Google 首页在世界杯期间用来庆祝赛事、以足球经典技巧为主题制","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"作的一张趣味插画 Logo。\n\nSources:\n- [World Cup 2026: The Art of the Bicycle Kick Doodle - Google Doodles](https://doodles.google/do","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"odle/world-cup-2026-the-art-of-the-bicycle-kick-617/)\n- [Google Doodles/2026 | Logopedia | Fandom](https://logos.fandom.com/wiki/Google_Do","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":"odles/2026)\n- [World Cup 2026: The art of the bicycle kick - YouTube](https://www.youtube.com/watch?v=Te8biWBDDdo)\n- [Bicycle kick - Wikipedia](https://en.wikipedia","type":"text_delta"},"index":3,"type":"content_block_delta"}

event: content_block_delta
data: {"delta":{"text":".org/wiki/Bicycle_kick)","type":"text_delta"},"index":3,"type":"content_block_delta"}

